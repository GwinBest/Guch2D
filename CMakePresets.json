{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 29,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Debug",
      "description": "Debug build with demo and tests enabled.",
      "binaryDir": "${sourceDir}/Build/Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_DEMO": "ON",
        "BUILD_TEST": "ON",
        "SFML_BUILD_AUDIO": "OFF",
        "SFML_BUILD_NETWORK": "OFF"
      }
    },
    {
      "name": "debug-coverage",
      "displayName": "Debug-Coverage",
      "description": "Debug coverage build with demo and tests enabled.",
      "binaryDir": "${sourceDir}/Build/DebugCoverage",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_DEMO": "ON",
        "BUILD_TEST": "ON",
        "ENABLE_COVERAGE": "ON",
        "SFML_BUILD_AUDIO": "OFF",
        "SFML_BUILD_NETWORK": "OFF"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "description": "Release build with demo enabled.",
      "binaryDir": "${sourceDir}/Build/Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_DEMO": "ON",
        "SFML_BUILD_AUDIO": "OFF",
        "SFML_BUILD_NETWORK": "OFF"
      }
    },
    {
      "name": "relwithdebinfo",
      "displayName": "RelWithDebInfo",
      "description": "Optimized build with debug information and demo enabled.",
      "binaryDir": "${sourceDir}/Build/RelWithDebInfo",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "BUILD_DEMO": "ON",
        "BUILD_TEST": "ON",
        "SFML_BUILD_AUDIO": "OFF",
        "SFML_BUILD_NETWORK": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "debug-coverage",
      "configurePreset": "debug-coverage"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "relwithdebinfo",
      "configurePreset": "relwithdebinfo"
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "debug-coverage",
      "configurePreset": "debug-coverage",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "relwithdebinfo",
      "configurePreset": "relwithdebinfo",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
